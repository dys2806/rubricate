{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/dys2806/rubricate/schema/rubric.schema.json",
  "title": "rubricate rubric",
  "description": "A portable, versionable evaluation rubric for LLM responses and agent trajectories (spec v0.1).",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "spec",
    "id",
    "subject",
    "criteria"
  ],
  "properties": {
    "spec": {
      "description": "Version of the rubricate spec this file is written against.",
      "const": "0.1"
    },
    "id": {
      "description": "Stable identifier for this rubric. Lowercase letters, digits, hyphens and underscores.",
      "$ref": "#/$defs/identifier"
    },
    "title": {
      "description": "Human-readable name.",
      "type": "string",
      "minLength": 1
    },
    "description": {
      "description": "What this rubric evaluates and when to use it.",
      "type": "string"
    },
    "subject": {
      "description": "What is being graded: a single model response, or a full agent run (messages plus tool calls).",
      "enum": [
        "response",
        "trajectory"
      ]
    },
    "criteria": {
      "description": "The criteria that make up the rubric. At least one is required.",
      "type": "array",
      "minItems": 1,
      "items": {
        "$ref": "#/$defs/criterion"
      }
    }
  },
  "$defs": {
    "identifier": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_-]*$",
      "maxLength": 64
    },
    "criterion": {
      "description": "Either a scored criterion (graded on a numeric scale) or an assertion (pass/fail rule).",
      "type": "object",
      "required": [
        "id"
      ],
      "properties": {
        "type": {
          "enum": [
            "scored",
            "assertion"
          ],
          "default": "scored"
        }
      },
      "if": {
        "properties": {
          "type": {
            "const": "assertion"
          }
        },
        "required": [
          "type"
        ]
      },
      "then": {
        "$ref": "#/$defs/assertion"
      },
      "else": {
        "$ref": "#/$defs/scored"
      }
    },
    "scored": {
      "description": "A criterion graded on a numeric scale with a written anchor for each level.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "question",
        "scale"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "scored"
        },
        "question": {
          "description": "The question a rater or judge answers for this criterion.",
          "type": "string",
          "minLength": 1
        },
        "weight": {
          "description": "Relative importance when combining criterion scores. Defaults to 1.",
          "type": "number",
          "exclusiveMinimum": 0,
          "default": 1
        },
        "scale": {
          "description": "Map of score level to the anchor text that describes it. Keys are non-negative integers.",
          "type": "object",
          "minProperties": 2,
          "propertyNames": {
            "pattern": "^(0|[1-9][0-9]*)$"
          },
          "additionalProperties": {
            "type": "string",
            "minLength": 1
          }
        },
        "examples": {
          "description": "Worked examples that show what a given score looks like.",
          "type": "array",
          "items": {
            "$ref": "#/$defs/example"
          }
        }
      }
    },
    "assertion": {
      "description": "A pass/fail rule, typically over the order and arguments of an agent's tool calls.",
      "type": "object",
      "additionalProperties": false,
      "required": [
        "id",
        "type",
        "rule"
      ],
      "properties": {
        "id": {
          "$ref": "#/$defs/identifier"
        },
        "type": {
          "const": "assertion"
        },
        "rule": {
          "description": "The rule in plain language, shown in reports. Add `check` to make it machine-checkable.",
          "type": "string",
          "minLength": 1
        },
        "severity": {
          "description": "blocker: a failure fails the whole evaluation. warning: reported but not fatal.",
          "enum": [
            "blocker",
            "warning"
          ],
          "default": "warning"
        },
        "check": {
          "$ref": "#/$defs/check"
        }
      }
    },
    "example": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "score",
        "output"
      ],
      "properties": {
        "score": {
          "description": "The scale level this example illustrates.",
          "type": "integer",
          "minimum": 0
        },
        "input": {
          "description": "Optional prompt or context the output responds to.",
          "type": "string"
        },
        "output": {
          "description": "The response (or trajectory summary) being illustrated.",
          "type": "string",
          "minLength": 1
        },
        "rationale": {
          "description": "Why this output earns this score.",
          "type": "string"
        }
      }
    },
    "tool_name": {
      "type": "string",
      "minLength": 1,
      "description": "Name of a tool the agent can call."
    },
    "where": {
      "description": "Only calls whose arguments match every condition count. Keys are argument names; dotted keys reach into nested arguments.",
      "type": "object",
      "minProperties": 1,
      "additionalProperties": {
        "type": "object",
        "minProperties": 1,
        "additionalProperties": false,
        "properties": {
          "eq": {},
          "ne": {},
          "gt": {
            "type": "number"
          },
          "gte": {
            "type": "number"
          },
          "lt": {
            "type": "number"
          },
          "lte": {
            "type": "number"
          },
          "in": {
            "type": "array"
          }
        }
      }
    },
    "check": {
      "description": "A machine-checkable rule over an agent trajectory.",
      "type": "object",
      "required": [
        "kind"
      ],
      "properties": {
        "kind": {
          "enum": [
            "requires_before",
            "forbidden",
            "required",
            "max_calls"
          ]
        }
      },
      "allOf": [
        {
          "if": {
            "properties": {
              "kind": {
                "const": "requires_before"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "tool",
              "requires"
            ],
            "properties": {
              "kind": {},
              "tool": {
                "$ref": "#/$defs/tool_name"
              },
              "requires": {
                "$ref": "#/$defs/tool_name"
              },
              "where": {
                "$ref": "#/$defs/where"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "enum": [
                  "forbidden",
                  "required"
                ]
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "tool"
            ],
            "properties": {
              "kind": {},
              "tool": {
                "$ref": "#/$defs/tool_name"
              },
              "where": {
                "$ref": "#/$defs/where"
              }
            }
          }
        },
        {
          "if": {
            "properties": {
              "kind": {
                "const": "max_calls"
              }
            }
          },
          "then": {
            "additionalProperties": false,
            "required": [
              "kind",
              "max"
            ],
            "properties": {
              "kind": {},
              "tool": {
                "$ref": "#/$defs/tool_name"
              },
              "max": {
                "type": "integer",
                "minimum": 0
              },
              "where": {
                "$ref": "#/$defs/where"
              }
            }
          }
        }
      ]
    }
  }
}
